<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      NU1900 (transient: advisory feed unreachable) stays suppressed; CS1591 is missing-XML-doc.
      NU1901-1904 (package vulnerability advisories) are deliberately NOT suppressed so a new
      advisory surfaces in every restore/build. NuGetAuditMode=all audits the whole transitive
      graph, not just direct references (the default). They are downgraded to warnings via
      WarningsNotAsErrors so a newly-disclosed upstream CVE surfaces loudly without turning the
      whole family's CI red on an external event with no code change - remove that line to make
      advisories hard build errors instead.
    -->
    <NoWarn>CS1591;NU1900</NoWarn>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Authors>Tunahan Ali Ozturk</Authors>
    <Company>Tunahan Ali Ozturk</Company>
    <RepositoryUrl>https://github.com/tunahanaliozturk/OrionPatch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tunahanaliozturk/OrionPatch</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.4.2</Version>
  </PropertyGroup>
  <!--
    Pack the icon, logo, and README into every packable project from one place, so a newly added
    sub-package can never ship to NuGet without them (the icon was missing on the Kafka /
    AzureServiceBus / RabbitMQ sub-packages when this was set per-csproj).
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/logo.png" Pack="true" PackagePath="docs/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
